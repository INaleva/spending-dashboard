# Copy this file to .env and fill in only the institutions you use. Leave the others empty:
# a source is scraped only when ALL of its values are filled in.
# .env is git-ignored. Never commit, upload or share it.
#
# These are the same login details you type on each institution's website.
# "ID" = national ID (תעודת זהות), 9 digits including a leading 0.

# ===================== Banks =====================

# Bank Hapoalim (בנק הפועלים): user code and password
HAPOALIM_USER_CODE=
HAPOALIM_PASSWORD=

# Bank Leumi (בנק לאומי)
LEUMI_USERNAME=
LEUMI_PASSWORD=

# Mizrahi Tefahot (מזרחי טפחות)
MIZRAHI_USERNAME=
MIZRAHI_PASSWORD=

# Discount Bank (דיסקונט): ID, password, and the identification code ("קוד מזהה") given by the bank
DISCOUNT_ID=
DISCOUNT_PASSWORD=
DISCOUNT_NUM=

# Mercantile Bank (מרכנתיל): ID, password, and the identification code ("קוד מזהה")
MERCANTILE_ID=
MERCANTILE_PASSWORD=
MERCANTILE_NUM=

# First International / Beinleumi (הבינלאומי)
BEINLEUMI_USERNAME=
BEINLEUMI_PASSWORD=

# Otsar Hahayal (אוצר החייל)
OTSAR_HAHAYAL_USERNAME=
OTSAR_HAHAYAL_PASSWORD=

# Massad (מסד)
MASSAD_USERNAME=
MASSAD_PASSWORD=

# Pagi (פאגי)
PAGI_USERNAME=
PAGI_PASSWORD=

# Union Bank (בנק איגוד)
UNION_USERNAME=
UNION_PASSWORD=

# Bank Yahav (יהב): username, ID and password
YAHAV_USERNAME=
YAHAV_NATIONAL_ID=
YAHAV_PASSWORD=

# One Zero (וואן זירו): email, password, and a long-term token instead of an SMS code each time.
# Get the token once with:  node onezero-token.mjs
ONEZERO_EMAIL=
ONEZERO_PASSWORD=
ONEZERO_OTP_LONG_TERM_TOKEN=

# ===================== Credit cards =====================

# Cal / Visa Cal (כאל)
CAL_USERNAME=
CAL_PASSWORD=

# Max (מקס, formerly Leumi Card)
MAX_USERNAME=
MAX_PASSWORD=

# Isracard (ישראכרט): ID, the LAST 6 digits of the card, and the password
ISRACARD_ID=
ISRACARD_CARD6=
ISRACARD_PASSWORD=

# American Express (אמריקן אקספרס, issued by Isracard): ID, the LAST 6 digits of the card, and the password
AMEX_ID=
AMEX_CARD6=
AMEX_PASSWORD=

# Beyahad Bishvilha (ביחד בשבילך)
BEYAHAD_ID=
BEYAHAD_PASSWORD=

# Behatsdaa (בהצדעה)
BEHATSDAA_ID=
BEHATSDAA_PASSWORD=
